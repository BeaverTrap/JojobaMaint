# Supabase project credentials
# Find these in your Supabase dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# OAuth callback base URL. Must match your live site in production (Vercel env).
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app  (not localhost — baked in at build time)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Community Facebook group — shows "Our Facebook group" / "Post in our Facebook group" buttons.
# Example: https://www.facebook.com/groups/123456789012345
NEXT_PUBLIC_FACEBOOK_GROUP_URL=

# Vercel Cron auth — required for scheduled sync jobs (server-only).
# Used by /api/calendar/sync (daily) and /api/sheets/sync?type=all (weekly water + valves).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRON_SECRET=your-random-secret

# MaintainX public work-request portal — nav links here when set; /request redirects.
# Example: https://app.getmaintainx.com/work-request/your-portal-id
NEXT_PUBLIC_MAINTAINX_URL=

# ── Google Calendar sync (server-only — never prefix with NEXT_PUBLIC_) ──
# Setup checklist:
# 1. Google Cloud Console → enable "Google Calendar API"
# 2. IAM → Service Accounts → create key → download JSON
# 3. Google Calendar → share the maintenance calendar with the service account
#    email (permission: "See all event details" is enough for read-only sync)
# 4. Add the three required vars below to .env.local and Vercel (Production + Preview)
#
# Service account JSON as ONE line (private_key must keep \n escapes, not real newlines):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}
#
# Calendar ID — Settings → Integrate calendar → Calendar ID (often an email):
# GOOGLE_CALENDAR_ID=maintenance.jojoba@gmail.com
#
# Supabase service role — Project Settings → API → service_role (server/webhook only):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Optional: secret Google sends as X-Goog-Channel-Token on push notifications.
# GOOGLE_CALENDAR_WEBHOOK_TOKEN=your-random-secret
#
# Optional: public webhook URL base (defaults to NEXT_PUBLIC_SITE_URL). Must be HTTPS in production.
# GOOGLE_CALENDAR_WEBHOOK_URL=https://your-app.vercel.app

# ── Google Sheets valve / zone / lot database (same service account) ──
# Master Zone & Valve spreadsheet — tabs: Valve Sheet, Zone Sheet, optional CCCP tab
# Cross-connection / CCCP tab (any of these names): CCCP Installation, CCCP, Lot Sheet, Cross Connection
# Expected columns: Lot #, Unit ID (CCCP device id), Cross Connection (yes/no), Notes
# GOOGLE_VALVE_SHEET_ID=1jCYJkUO6wh9vvZ6GKpr7Azi117V-IeB8Hii-iyFyCo8
# (alias: GOOGLE_SHEETS_ID)
# Or legacy split format instead of GOOGLE_SERVICE_ACCOUNT_JSON:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=...@....iam.gserviceaccount.com
# (alias accepted on Vercel: GOOGLE_CLIENT_EMAIL)
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Google Sheets water / Monthly Report (same service account; share the sheet) ──
# Spreadsheet ID from the sheet URL: docs.google.com/spreadsheets/d/THIS_PART/edit
# GOOGLE_WATER_SHEET_ID=1yihjTeBpq-4oxVkVBeHPF-aBEuWv7t7ArPklPGz_CZg
# Sync reads "Usage Calculations" (powers the Monthly Report tab). gid=1898863518
# GOOGLE_WATER_SHEET_GID=1898863518

# ── Google Maps (optional — park map with schematic overlay + custom icons) ──
# Enable "Maps JavaScript API" in Google Cloud Console; create a Map ID for Advanced Markers.
# Without this key, /map uses the built-in PNG map instead.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAP_ID=
# Optional map focus bounds (north,south,east,west) — only needed for legacy percent coords:
# NEXT_PUBLIC_PARK_MAP_BOUNDS=33.456,33.441,-116.863,-116.881
