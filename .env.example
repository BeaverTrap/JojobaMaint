# Supabase project credentials
# Find these in your Supabase dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Used to build absolute redirect URLs for the OAuth callback.
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Facebook group most residents use — enables "Post in Facebook group" on share panels.
# Example: https://www.facebook.com/groups/123456789012345
NEXT_PUBLIC_FACEBOOK_GROUP_URL=
