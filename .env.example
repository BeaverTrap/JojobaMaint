# Supabase project credentials
# Find these in your Supabase dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# OAuth callback base URL. Must match your live site in production (Vercel env).
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app  (not localhost — baked in at build time)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Community Facebook group — shows "Our Facebook group" / "Post in our Facebook group" buttons.
# Example: https://www.facebook.com/groups/123456789012345
NEXT_PUBLIC_FACEBOOK_GROUP_URL=

# ── Google Calendar sync (server-only — never prefix with NEXT_PUBLIC_) ──
# Service account JSON (single line). Share the calendar with the service account email.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Calendar ID (email address or "primary" for the shared calendar owner).
# GOOGLE_CALENDAR_ID=maintenance.jojoba@gmail.com
# Optional secret token Google sends back as X-Goog-Channel-Token on push notifications.
# GOOGLE_CALENDAR_WEBHOOK_TOKEN=your-random-secret
# Public webhook URL base (defaults to NEXT_PUBLIC_SITE_URL). Must be HTTPS in production.
# GOOGLE_CALENDAR_WEBHOOK_URL=https://your-app.vercel.app
# Supabase service role key — required for webhook writes (Project Settings → API).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
